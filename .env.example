# Copy to .env.local for local dev, and paste the same values into
# Vercel → Project → Settings → Environment Variables before deploying.

# ── GitHub ────────────────────────────────────────────────────────────
# Required. Without it you get 60 requests/hour per IP, which is roughly
# eight visitors before the site is hard-down. With it: 5,000/hour.
# Create at https://github.com/settings/tokens?type=beta
# A fine-grained token with NO account permissions and NO repository access
# is enough — everything read here is public. Just generate and copy.
GITHUB_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────────
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → service_role (click to reveal)
# Server-side only. This bypasses row-level security, so it must never be
# prefixed NEXT_PUBLIC_ and never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────
# The address people actually visit. Canonical URLs and share-card links
# are built from it, so getting it wrong means a shared link advertises a
# different hostname than the one it was copied from.
#
# SET THIS to whatever is in your address bar. Auto-detection falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which is Vercel's *generated* project URL
# (merged-sooty.vercel.app) — not any alias or custom domain you added, and
# not the name you renamed the project to.
#
# No trailing slash. Example: https://itsmerged.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Jobs ──────────────────────────────────────────────────────────────
# Any long random string. Guards the nightly refresh endpoint so nobody
# else can trigger it. Generate with: openssl rand -hex 32
CRON_SECRET=
